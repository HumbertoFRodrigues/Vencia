# Safety net for shared hosting: if the domain's document root points at
# this project folder instead of public/, every request is routed through
# public/ — so .env, storage/, database/ and the source code are never
# served directly. With the document root correctly set to public/ this
# file is simply never read.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
